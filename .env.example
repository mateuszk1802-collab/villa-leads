# Skopiuj ten plik jako .env.local (lokalnie) albo wpisz te zmienne w Vercel
# (Project → Settings → Environment Variables). Nigdy nie wrzucaj prawdziwych kluczy do repo.

# Supabase → Project Settings → API (Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co

# Supabase → Project Settings → API Keys → klucz "anon public" albo "publishable" (sb_publishable_...)
# To klucz publiczny — dane chroni logowanie + reguły RLS z pliku supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-klucz-publiczny

# (Opcjonalnie) Wyszukiwarka firm — Google Cloud → APIs & Services → Credentials → API key.
# W Vercel dodaj jako typ "Secret". Bez tej zmiennej aplikacja działa, tylko bez zakładki "Szukaj w Google".
GOOGLE_PLACES_API_KEY=
